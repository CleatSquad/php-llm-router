{
    "name": "mohaelmrabet/php-llm-router",
    "description": "Provider-agnostic LLM client for PHP — a uniform interface over Claude, OpenAI, Gemini, Mistral, Groq, DeepSeek, Ollama, LiteLLM and Kimi, with pluggable routing, retries, caching, circuit breaking and rate limiting.",
    "type": "library",
    "license": "MIT",
    "keywords": ["llm", "ai", "claude", "openai", "gemini", "mistral", "groq", "deepseek", "ollama", "litellm", "router", "fallback", "circuit-breaker", "rate-limit"],
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LlmRouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LlmRouter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
